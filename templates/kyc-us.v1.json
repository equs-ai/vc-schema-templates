{
  "id": "kyc-us",
  "version": 1,
  "category": "kyc",
  "name": "KYC identity US",
  "description": "An identity credential issued off the back of completed customer identification for US customers. It attests that identity was verified, against which document type, and when. It does not carry screening outcomes; relying parties check current status via the status list.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "bgColor": "#F3E8FF",
  "textColor": "#000000",
  "logo": {
    "uri": "https://raw.githubusercontent.com/equs-ai/vc-schema-templates/main/images/kyc.png",
    "altText": "KYC Logo"
  },
  "claimDefs": [
    {
      "path": [
        "full_name"
      ],
      "name": "Full Name",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "birth_date"
      ],
      "name": "Date of Birth",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "email"
      ],
      "name": "Email",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "phone"
      ],
      "name": "Phone Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "address"
      ],
      "name": "Residential Address",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "tax_number_last4"
      ],
      "name": "Tax Number (last four digits)",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document"
      ],
      "name": "Identity Document",
      "dataType": "Display",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "type"
      ],
      "name": "Identity Document Type",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "issuing_state"
      ],
      "name": "Identity Document Issuing State",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "number"
      ],
      "name": "Identity Document Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "identity_document", "expiration"
      ],
      "name": "Identity Document Expiration Date",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "verification_completed_at"
      ],
      "name": "Identity Verification Completed At",
      "dataType": "Date",
      "mandatory": true
    }
  ]
}
