{
  "id": "kyc-identity-us",
  "version": 1,
  "category": "kyc/aml",
  "name": "KYC identity US",
  "description": "An identity credential issued off the back of a completed KYC check for US customers.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "bgColor": "#F3E8FF",
  "textColor": "#FFFFFF",
  "logo": {
    "uri": "https://github.com/equs-ai/vc-schema-templates/blob/main/images/kyc.png",
    "altText": "KYC Logo"
  },
  "claimDefs": [
    {
      "path": [
        "full_name"
      ],
      "name": "Full Name",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "birth_date"
      ],
      "name": "Date of Birth",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "email"
      ],
      "name": "Email",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "phone"
      ],
      "name": "Phone Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "address"
      ],
      "name": "Residential Address",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "tax_number"
      ],
      "name": "Tax Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "driver_license"
      ],
      "name": "Driver License Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "ofac_check"
      ],
      "name": "OFAC Check Result",
      "dataType": "Boolean",
      "mandatory": true
    }
  ]
}
