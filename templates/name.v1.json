{
  "id": "name",
  "version": 1,
  "category": "identity",
  "name": "Name",
  "description": "A credential attesting the given and family name of the holder.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "expiration": 31536000,
  "bgColor": "#FFFFFF",
  "textColor": "#000000",
  "claimDefs": [
    {
      "path": [
        "first_name"
      ],
      "name": "First name",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "last_name"
      ],
      "name": "Last name",
      "dataType": "Text",
      "mandatory": true
    }
  ]
}
