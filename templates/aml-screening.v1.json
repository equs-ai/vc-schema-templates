{
  "id": "aml-screening",
  "version": 1,
  "category": "aml",
  "name": "AML screening",
  "description": "A credential attesting the outcome and date of an anti-money-laundering screening.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "expiration": 31536000,
  "assurance": "high",
  "bgColor": "#1F3A5F",
  "textColor": "#FFFFFF",
  "claimDefs": [
    {
      "path": [
        "aml"
      ],
      "name": "AML screening",
      "dataType": "Display",
      "mandatory": true
    },
    {
      "path": [
        "aml",
        "screening_result"
      ],
      "name": "Screening result",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "aml",
        "screened_at"
      ],
      "name": "Screened at",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "aml",
        "sanctions_match"
      ],
      "name": "Sanctions list match",
      "dataType": "Boolean",
      "mandatory": true
    },
    {
      "path": [
        "aml",
        "pep_match"
      ],
      "name": "Politically exposed person match",
      "dataType": "Boolean",
      "mandatory": false
    }
  ]
}
