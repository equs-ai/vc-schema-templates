{
  "id": "kyc-aml-identity-eu",
  "version": 1,
  "category": "kyc/aml",
  "name": "KYC/AML identity EU",
  "description": "An identity credential issued off the back of a completed KYC/AML check for EU customers.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "bgColor": "#F3E8FF",
  "textColor": "#FFFFFF",
  "logo": {
    "uri": "https://github.com/equs-ai/vc-schema-templates/blob/main/images/kyc.png",
    "altText": "KYC Logo"
  },
  "claimDefs": [
    {
      "path": [
        "full_name"
      ],
      "name": "Full Name",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "birth_date"
      ],
      "name": "Date of Birth",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "email"
      ],
      "name": "Email",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "phone"
      ],
      "name": "Phone Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "address"
      ],
      "name": "Residential Address",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "citizenship"
      ],
      "name": "Citizenship",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "residence_country"
      ],
      "name": "Country of Residence",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "residence_status"
      ],
      "name": "Residence Status",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "tax_number"
      ],
      "name": "Tax Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "type"
      ],
      "name": "Identity Document Type",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "number"
      ],
      "name": "Identity Document Number",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "country"
      ],
      "name": "Identity Document Country",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "expiration"
      ],
      "name": "Identity Document Expiration Date",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "aml", "risk_category"
      ],
      "name": "AML Risk Category",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "aml", "screening_result"
      ],
      "name": "AML Screening Result",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "aml",
        "screened_at"
      ],
      "name": "AML Screened at",
      "dataType": "Date",
      "mandatory": false
    },
    {
      "path": [
        "aml",
        "sanctions_match"
      ],
      "name": "Sanctions List Match",
      "dataType": "Boolean",
      "mandatory": false
    },
    {
      "path": [
        "aml",
        "pep_match"
      ],
      "name": "Politically Exposed Person Match",
      "dataType": "Boolean",
      "mandatory": false
    }

  ]
}
