{
  "id": "kyc-aml-eu",
  "version": 1,
  "category": "kyc",
  "name": "KYC and AML identity EU",
  "description": "An identity credential issued off the back of completed identity verification for EU customers. Carries the Article 22(1) AMLR dataset so a relying obliged entity can use it as a verification means. It does not carry due diligence conclusions or screening outcomes; relying parties perform their own CDD and check current status via the status list.",
  "format": "SdJwtVc",
  "bindMethod": [
    "JWK"
  ],
  "credSignAlgs": [
    "ES256"
  ],
  "proofSignAlgs": [
    "ES256"
  ],
  "bgColor": "#F3E8FF",
  "textColor": "#000000",
  "logo": {
    "uri": "https://raw.githubusercontent.com/equs-ai/vc-schema-templates/main/images/kyc.png",
    "altText": "KYC Logo"
  },
  "claimDefs": [
    {
      "path": [
        "full_name"
      ],
      "name": "Full Name",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "birth_date"
      ],
      "name": "Date of Birth",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "birth_place"
      ],
      "name": "Place of Birth",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "email"
      ],
      "name": "Email",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "phone"
      ],
      "name": "Phone Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "address"
      ],
      "name": "Residential Address",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "citizenship"
      ],
      "name": "Citizenship",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "residence_country"
      ],
      "name": "Country of Residence",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "residence_status"
      ],
      "name": "Residence Status",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "national_id_number"
      ],
      "name": "National Identification Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "tax_number"
      ],
      "name": "Tax Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "identity_document"
      ],
      "name": "Identity Document",
      "dataType": "Display",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "type"
      ],
      "name": "Identity Document Type",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "number"
      ],
      "name": "Identity Document Number",
      "dataType": "Text",
      "mandatory": false
    },
    {
      "path": [
        "identity_document", "country"
      ],
      "name": "Identity Document Country",
      "dataType": "Text",
      "mandatory": true
    },
    {
      "path": [
        "identity_document", "expiration"
      ],
      "name": "Identity Document Expiration Date",
      "dataType": "Date",
      "mandatory": true
    },
    {
      "path": [
        "verification_completed_at"
      ],
      "name": "Identity Verification Completed At",
      "dataType": "Date",
      "mandatory": true
    }
  ]
}
