{
  "registryVersion": "0.1.0",
  "templates": [
    {
      "id": "address",
      "version": 1,
      "category": "identity",
      "name": "Address",
      "description": "A credential attesting the postal address of the holder.",
      "format": "SdJwtVc",
      "bindMethod": [
        "JWK"
      ],
      "credSignAlgs": [
        "ES256"
      ],
      "proofSignAlgs": [
        "ES256"
      ],
      "expiration": 31536000,
      "logo": {
        "uri": "https://pub-e63b17b4d990438a83af58c15949f8a2.r2.dev/mark/kanba.png",
        "altText": "Address logo"
      },
      "bgColor": "#99BDDC",
      "textColor": "#000000",
      "claimDefs": [
        {
          "path": [
            "address",
            "zip_code"
          ],
          "name": "Zip code",
          "dataType": "Text",
          "mandatory": false
        },
        {
          "path": [
            "address",
            "city"
          ],
          "name": "City",
          "dataType": "Text",
          "mandatory": false
        },
        {
          "path": [
            "address",
            "state"
          ],
          "name": "State",
          "dataType": "Text",
          "mandatory": false
        }
      ]
    },
